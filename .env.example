# Copy to .env and fill locally. Never commit real keys.
# The service key is for calls from your trusted backend, not browser JavaScript.
SID_SERVICE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Requested model. Confirm availability in your Groq account: current public
# model documentation labels Llama 3.1 8B Enterprise, not guaranteed free-tier.
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.1-flash-lite

AI_PROVIDER_TIMEOUT_SECONDS=15
AI_REQUEST_TIMEOUT_SECONDS=35
AI_MAX_CONCURRENT_REQUESTS=4
AI_MAX_OUTPUT_TOKENS=1200
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RECOVERY_SECONDS=30
AI_CONFIGURATION_COOLDOWN_SECONDS=300

# Phase 2. Leave blank to keep the Phase 1 preview-only configuration.
# Development replica set: mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_URI=
# On the real platform, choose the database containing the existing domain collections.
MONGODB_DATABASE=sid_agent
MONGODB_TIMEOUT_SECONDS=5

# UML field mapping uses id, userId, companyId, role, isActive.
# Confirm actual collection names with the main platform.
PLATFORM_USERS_COLLECTION=users
PLATFORM_CANDIDATES_COLLECTION=candidate_profiles
PLATFORM_COMPANIES_COLLECTION=company_profiles
PLATFORM_OFFERS_COLLECTION=job_offers

# Use the same scope/settings on every API/worker sharing the same provider keys.
# Positive limits must come from your accounts. Zero disables that provider in Phase 2.
AI_ACCOUNT_SCOPE=default
AI_SHARED_MAX_CONCURRENT_REQUESTS=4
GROQ_REQUESTS_PER_MINUTE=0
GROQ_TOKENS_PER_MINUTE=0
GROQ_REQUESTS_PER_DAY=0
GEMINI_REQUESTS_PER_MINUTE=0
GEMINI_TOKENS_PER_MINUTE=0
GEMINI_REQUESTS_PER_DAY=0
WORKER_LEASE_SECONDS=90
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1

# Phase 3: local reference-data search. Leave URL blank to disable it.
# Development Qdrant: http://127.0.0.1:6335
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30
EMBEDDING_MODEL_DIRECTORY=.models/multilingual-minilm
EMBEDDING_THREADS=2
INDEXING_BATCH_SIZE=16
KNOWLEDGE_MAX_CONCURRENT_QUERIES=2
