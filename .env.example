# Copy to .env and fill locally. Never commit real keys.
# The service key is for calls from your trusted backend, not browser JavaScript.
SID_SERVICE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Requested model. Confirm availability in your Groq account: current public
# model documentation labels Llama 3.1 8B Enterprise, not guaranteed free-tier.
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.1-flash-lite

AI_PROVIDER_TIMEOUT_SECONDS=15
AI_REQUEST_TIMEOUT_SECONDS=35
AI_MAX_CONCURRENT_REQUESTS=4
AI_MAX_OUTPUT_TOKENS=1200
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RECOVERY_SECONDS=30
AI_CONFIGURATION_COOLDOWN_SECONDS=300
